# Sender template. Replace ALL __...__ values and check with rsyslogd -N1.
# Requires an rsyslog build with GnuTLS and a writable queue work directory.
module(load="imfile")
ruleset(name="infra_audit_forward_tls") {
  action(type="omfwd" target="__REMOTE_HOST__" port="__REMOTE_PORT__" protocol="tcp"
         template="RSYSLOG_SyslogProtocol23Format"
         StreamDriver="gtls" StreamDriverMode="1"
         StreamDriverAuthMode="x509/name"
         StreamDriverPermittedPeers="__REMOTE_HOST__"
         StreamDriver.CAFile="/etc/infra-audit/tls/ca.pem"
         StreamDriver.CertFile="/etc/infra-audit/tls/client.pem"
         StreamDriver.KeyFile="/etc/infra-audit/tls/client-key.pem"
         action.resumeRetryCount="-1"
         queue.type="LinkedList" queue.size="10000"
         queue.filename="infra_audit_tls_fwd" queue.maxDiskSpace="1g"
         queue.saveOnShutdown="on")
}
input(type="imfile" File="/var/log/infra-audit/normalized.jsonl"
      Tag="infra-audit:" Facility="local6" Severity="info"
      PersistStateInterval="100" ruleset="infra_audit_forward_tls")
# Requires the distro's existing imuxsock/imjournal input to ingest logger messages.
if $syslogtag startswith "infra-audit-shell:" then {
  call infra_audit_forward_tls
  stop
}
# Optional syslog sources; confirm the local distro actually emits these tags.
if ($syslogtag startswith "rootsh" or $syslogtag startswith "pvedaemon" or $syslogtag startswith "pveproxy") then {
  call infra_audit_forward_tls
  stop
}
